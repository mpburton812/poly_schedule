{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node generate-version.js",
  "installCommand": "npm install --omit=dev",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|icons/|css/|js/|assets/|sw.js|manifest.json|version.json|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
