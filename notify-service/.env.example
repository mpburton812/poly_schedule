PORT=8787
NOTIFY_SECRET=replace-with-long-random-secret
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Required for Phase 3 Google Calendar webhooks (public HTTPS URL of this service)
PUBLIC_BASE_URL=https://polyschedule-notify.onrender.com

# Optional persistent data directory (household cache, watches, subscriptions)
DATA_DIR=./data

# Optional email fallback (when a partner has no registered push device)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PolySchedule <noreply@example.com>
